{
  "name": "ioredis-ratelimit",
  "description": "A generic Redis-backed rate limiting tool built on top of ioredis.",
  "version": "3.2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "types",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "pretest": "redis-cli ping > /dev/null 2>&1 || (echo 'Error: Redis is not running. Please start Redis first.' && exit 1)",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build": "tsup",
    "prepublishOnly": "npm run lint && npm run test && npm run build",
    "prepare": "husky"
  },
  "author": "nswbmw",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nswbmw/ioredis-ratelimit.git"
  },
  "keywords": [
    "ratelimit",
    "ratelimiter",
    "redis"
  ],
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "eslint": "9.39.4",
    "globals": "17.10.0",
    "husky": "9.1.7",
    "ioredis": "6.0.0",
    "jest": "30.4.2",
    "neostandard": "0.13.0",
    "tsup": "8.5.1"
  },
  "peerDependencies": {
    "ioredis": "^6.0.0"
  }
}
